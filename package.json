{
  "name": "slabs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm --filter @slabs/web build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "dev": "pnpm --filter @slabs/web dev",
    "goldens": "node scripts/make-goldens.mjs",
    "e2e": "node packages/web/e2e/smoke.mjs && node packages/web/e2e/rooms.mjs && node packages/web/e2e/spec.mjs && node packages/web/e2e/cloud.mjs",
    "e2e:cloud": "node packages/web/e2e/cloud.mjs"
  },
  "devDependencies": {
    "@clerk/backend": "^3.31.4",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "@upstash/redis": "^1.41.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
